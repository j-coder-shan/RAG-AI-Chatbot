# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434

# Models — must already be pulled via `ollama pull <name>`
# Use phi3:mini for CHAT_MODEL instead if running on <8GB RAM/VRAM
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# Storage paths (relative to repo root)
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./uploads

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_K=4

# Frontend -> backend connection (change after deployment, see PLAN.md Phase 7)
BACKEND_URL=http://localhost:8000
